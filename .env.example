# Copiá este archivo a ".env" y completá con tus valores reales.
# El .env NUNCA se sube a git (ver .gitignore).

DATABASE_URL=postgresql://fixedgarage:fixedgarage@localhost:5432/fixedgarage

# Inventá cualquier string larga y random, es tu clave de admin.
ADMIN_API_KEY=cambiame-por-algo-secreto

# Datos de tu cuenta en cloudinary.com (plan free)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
